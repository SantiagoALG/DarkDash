}

function renderPqCapacity() {
  const container = document.getElementById('pq-capacity-bars');
  const activeQ   = getActiveQuotes();
  if (!activeQ.length) {
    container.innerHTML = '<p style="font-size:.82rem;color:var(--ink-soft)">Selecciona cotizaciones en A o B para ver el impacto.</p>';
    return;
  }

  container.innerHTML = employees.map(emp => {
    const curHrs  = getEmployeeAssignedHrs(emp.id);
    const proHrs  = projectedEmpHrs(emp.id);
    const extraH  = proHrs - curHrs;
    if (curHrs === 0 && extraH === 0) return '';

    const curW  = Math.min(curHrs  / CAP_MAX * 100, 100);
    const proW  = Math.min(proHrs  / CAP_MAX * 100, 120); // allow slight overflow visual
    const curColor = curHrs  > CAP_MAX ? 'var(--accent-2)' : curHrs  > CAP ? 'var(--gold)' : 'var(--accent)';
    const proColor = proHrs  > CAP_MAX ? 'var(--accent-2)' : proHrs  > CAP ? 'var(--gold)' : '#7c3aed';

    return `<div class="cap-row" style="margin-bottom:6px">
      <span class="cap-name" style="min-width:110px">${emp.name}</span>
      <div style="flex:1;position:relative;height:12px;background:var(--paper-3);border-radius:6px;overflow:visible">
        <!-- ghost projected bar (behind) -->
        <div class="ghost-bar" style="width:${proW}%;background:${proColor};border-radius:6px"></div>
        <!-- current solid bar -->
        <div style="position:absolute;left:0;top:0;height:100%;width:${curW}%;background:${curColor};border-radius:6px;z-index:1"></div>
        <!-- 120hr marker -->
        <div style="position:absolute;left:${(CAP/CAP_MAX*100).toFixed(1)}%;top:-3px;height:18px;width:2px;background:var(--ink-soft);opacity:.35;z-index:2"></div>
      </div>
      <div style="min-width:90px;text-align:right;font-family:var(--mono);font-size:.72rem">
        <span style="color:${curColor}">${curHrs.toFixed(0)}h</span>
        ${extraH > 0 ? `<span style="color:#7c3aed"> +${extraH.toFixed(0)}h → ${proHrs.toFixed(0)}h</span>` : ''}
      </div>
    </div>`;
  }).filter(Boolean).join('');
}

// ── Toggle scenario inclusion ────────────────────────
function togglePqScen(id, scen) {
