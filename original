function renderEmployees() {
  const sec   = document.getElementById('employees-section');
  const count = document.getElementById('emp-count');
  if (!sec) return;
  count.textContent = employees.length ? '(' + employees.length + ')' : '';
  const combined = employees.filter(e => corporates.some(c=>c.id===e.id&&c._combined));
  const billable = employees.filter(e => !corporates.some(c=>c.id===e.id&&c._combined));
  const corpOnly = corporates.filter(c => !c._combined);

  function makeTable(title, list, isCorp) {
    if (!list.length) return '';
    const rows = list.map(emp => {
      const hrs = isCorp ? 0 : getEmployeeAssignedHrs(emp.id);
      const pct = (hrs/CAP*100).toFixed(0);
      const st  = capStatus(hrs/CAP);
      const av  = getAvatarStyle(emp.name);
      const ini = emp.name.split(' ').map(w=>w[0]).join('').slice(0,2).toUpperCase();
      const delFn = isCorp ? 'deleteCorporate' : 'deleteEmployee';
      const edCat = isCorp ? "'corporate'" : "'billable'";
      return '<tr>'
        + '<td style="padding:6px 10px"><div class="avatar" style="background:'+av.bg+';color:'+av.color+'">'+ini+'</div></td>'
        + '<td><strong>'+emp.name+'</strong>'+(emp.implant?'<span class="badge ok" style="margin-left:6px">Implant</span>':'')+'</td>'
        + '<td style="color:var(--ink-soft);font-size:.78rem">'+(emp.role||'—')+'</td>'
        + '<td class="r">'+fmt(emp.salary||0)+'</td>'
        + '<td class="r">'+(isCorp?'—':hrs+'/'+CAP)+'</td>'
        + '<td class="r">'+(isCorp?'—':pct+'%')+'</td>'
        + '<td><span class="badge '+st.cls+'">'+st.label+'</span></td>'
        + '<td style="text-align:right;padding:6px 10px">'
        + '<button class="btn ghost" style="font-size:.6rem;padding:4px 8px" onclick="openEditEmployee('+emp.id+','+edCat+')">✏</button> '
        + '<button class="btn danger" style="font-size:.6rem;padding:4px 8px" onclick="'+delFn+'('+emp.id+')">✕</button>'
        + '</td></tr>';
    }).join('');
    return '<div style="background:var(--bone);padding:10px 20px;border-bottom:2px solid var(--rule-heavy);border-top:1px solid var(--rule);font-size:.62rem;font-weight:700;text-transform:uppercase;letter-spacing:.1em;color:var(--ink-soft)">'+title+'</div>'
      + '<div class="section-table-wrap"><table class="stbl"><thead><tr>'
      + '<th style="width:36px"></th><th>Nombre</th><th>Rol</th>'
      + '<th class="r">Honorarios</th><th class="r">Hrs asig.</th><th class="r">% Cap.</th>'
      + '<th>Estado</th><th style="width:80px"></th>'
      + '</tr></thead><tbody>'+rows+'</tbody></table></div>';
  }
  sec.innerHTML =
    makeTable('Colaboradores facturables', billable, false) +
    makeTable('Combinados', combined, false) +
    makeTable('Corporativos', corpOnly, true);
}

