        ${q._fromCot ? '<span class="badge ok" style="font-size:.6rem;flex-shrink:0">📋 Cotizador</span>' : ''}
        <button class="btn-add outline" style="font-size:.68rem;padding:4px 10px;flex-shrink:0" onclick="openAddPendingQuote(${q.id})">✏</button>
        <button class="btn-del-row" onclick="deletePendingQuote(${q.id})" style="flex-shrink:0">×</button>
      </div>
