          + '<button class="btn danger" style="font-size:.6rem;padding:4px 8px" onclick="deleteVendor('+v.id+')">✕</button>'
          + '</td></tr>';
      }).join('')
    + '</tbody></table>';
  const activeV = vendors.filter(isVendorActive);
  const totCostA = activeV.reduce((s,v)=>s+(v.cost||0),0);
  const totChgA  = activeV.reduce((s,v)=>s+(v.charge||0),0);
  const totMargA = totChgA - totCostA;
  if (sumCard) {
    sumCard.style.display='block';
    sumCard.innerHTML = '<div style="display:grid;grid-template-columns:repeat(4,1fr);border-left:1px solid var(--rule);border-top:1px solid var(--rule)">'
      + [['Activos',activeV.length+' de '+vendors.length],['Costo activos',fmt(totCostA)],['Cobro activos',fmt(totChgA)],['Margen',fmt(totMargA)]]
        .map(p=>'<div style="padding:14px 18px;border-right:1px solid var(--rule);border-bottom:1px solid var(--rule)">'
          +'<div style="font-size:.58rem;font-weight:700;text-transform:uppercase;letter-spacing:.1em;color:var(--ink-soft);margin-bottom:6px">'+p[0]+'</div>'
          +'<div style="font-family:var(--mono);font-size:1.1rem">'+p[1]+'</div></div>').join('')
      + '</div>';
  }
}

