<script>

// ── NULL-SAFE ELEMENT HELPER ─────────────────────────────────────────────
// Returns a dummy element proxy when an element doesn't exist in this theme.
// Prevents crashes when JS from the dark theme runs in the minimal theme.
const _nullEl = new Proxy({}, {
  get(t, prop) {
    if (prop === 'innerHTML' || prop === 'textContent' || prop === 'value') return '';
    if (prop === 'style') return new Proxy({}, { set() { return true; }, get() { return ''; } });
    if (prop === 'classList') return { add(){}, remove(){}, toggle(){}, contains(){ return false; } };
    if (prop === 'checked') return false;
    if (prop === 'options') return [];
    if (prop === 'length') return 0;
    return () => {};
  },
  set() { return true; }
});
function safeEl(id) {
  return document.getElementById(id) || _nullEl;
}

// Patch getElementById to never return null for known-missing elements
// (only in this minimal theme context)
const _origGetById = document.getElementById.bind(document);
document.getElementById = function(id) {
  return _origGetById(id) || _nullEl;
};

// ── POPOVER ─────────────────────────────────────────────────────────────
let _popHideTimer = null;

function showPopover(event, title, rows) {
  clearTimeout(_popHideTimer);
  const pop = document.getElementById('popover');
  pop.innerHTML = '<div class="popover-title">' + title + '</div>'
    + rows.map(r => '<div class="popover-row"><span class="popover-key">'
      + r[0] + '</span><span class="popover-val">' + r[1] + '</span></div>').join('');
  
  const x = event.clientX + 14;
  const y = event.clientY + 14;
  const vw = window.innerWidth, vh = window.innerHeight;
  pop.style.left = (x + 260 > vw ? x - 280 : x) + 'px';
  pop.style.top  = (y + 200 > vh ? y - 220 : y) + 'px';
  pop.classList.add('show');
}

function hidePopover() {
  _popHideTimer = setTimeout(() => {
    document.getElementById('popover').classList.remove('show');
  }, 120);
}

// ══════════════════════════════════════════════════════
// SUPABASE CONFIG
// Reemplaza estos valores con los de tu proyecto en supabase.com
// ══════════════════════════════════════════════════════
const SUPABASE_URL  = 'https://njocteicmmscpinfcgxc.supabase.co';
const SUPABASE_KEY  = 'eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6Im5qb2N0ZWljbW1zY3BpbmZjZ3hjIiwicm9sZSI6ImFub24iLCJpYXQiOjE3NzQ1OTExNDcsImV4cCI6MjA5MDE2NzE0N30.IuR17io-7_9jMkqJS3puFfhiAebwb1lTqvOt91RtcU0';

// Supabase REST helper
async function sbFetch(table, method='GET', body=null, filters='') {
  const url = `${SUPABASE_URL}/rest/v1/${table}${filters}`;
  const opts = {
    method,
    headers: {
      'Content-Type':  'application/json',
      'apikey':         SUPABASE_KEY,
      'Authorization': `Bearer ${SUPABASE_KEY}`,
      'Prefer':        'return=representation',
    },
  };
  if (body) opts.body = JSON.stringify(body);
  const res = await fetch(url, opts);
  if (!res.ok) {
    const err = await res.text();
    throw new Error(`Supabase ${method} ${table}: ${err}`);
  }
  // DELETE, PATCH without return=representation, and empty responses have no body
  if (method === 'DELETE' || method === 'PATCH') return null;
  const text = await res.text();
  if (!text || text.trim() === '') return null;
  return JSON.parse(text);
}

// ── LOAD ALL DATA FROM SUPABASE ─────────────────────
async function loadFromSupabase() {
  showSyncStatus('syncing');
  try {
    const [emps, corps, projs, vends, exps] = await Promise.all([
      sbFetch('alg_employees'),
      sbFetch('alg_corporates'),
      sbFetch('alg_projects'),
      sbFetch('alg_vendors'),
      sbFetch('alg_expenses'),
    ]);

    // Supabase returns rows with { id, data, is_combined? }
    // r.data is the jsonb column; spread safely with fallback
    const mapRow = (r) => {
      if (!r) return null;
      const d = r.data && typeof r.data === 'object' ? r.data : {};
      return { ...d, id: r.id };
    };
    employees  = (emps  ||[]).map(mapRow).filter(Boolean);
    corporates = (corps ||[]).map(r => r ? { ...(r.data||{}), id: r.id, _combined: !!r.is_combined } : null).filter(Boolean);
    projects   = (projs ||[]).map(mapRow).filter(Boolean);
    vendors    = (vends ||[]).map(mapRow).filter(Boolean);
    expenses   = (exps  ||[]).map(mapRow).filter(Boolean);

    // Keep local idCounter well above Supabase's max to avoid collisions
    const allIds = [
      ...(emps||[]), ...(corps||[]), ...(projs||[]), ...(vends||[]), ...(exps||[])
    ].map(r => r.id).filter(n => typeof n === 'number');
    const maxSbId = allIds.length ? Math.max(...allIds) : 0;
    idCounter = Math.max(idCounter, maxSbId + 1, 1000000);

    try {
      renderAll();
    } catch(renderErr) {
      console.error('Render error after load:', renderErr);
    }
    showSyncStatus('ok');
  } catch(e) {
    console.error('Supabase load error:', e);
    showSyncStatus('error', e.message);
    try { renderAll(); } catch(re) { console.error('Render error:', re); }
  }
}

// ── SAVE HELPERS ────────────────────────────────────
// Strategy: render locally immediately (fast UX), then sync to Supabase
// in the background. On reload, Supabase is the source of truth.

function stripLocalFields(record) {
  if (!record || typeof record !== 'object') return {};
  const clean = { ...record };
  ['_open','_showBd','_fromCotizador','_fromCot','_cat'].forEach(k => delete clean[k]);
  return clean;
}

// Safe render — catches errors so they don't propagate to sbSave catch block
function safeRenderAll() {
  try { renderAll(); }
  catch(e) { console.error('renderAll error:', e); }
}

async function sbSave(table, record) {
  const clean = stripLocalFields(record);
  const { id, ...data } = clean;
  try {
    showSyncStatus('syncing');
    const isNew = !id || (typeof id === 'number' && id >= 1000000);
    console.log('[sbSave]', table, isNew ? 'POST' : 'PATCH id=' + id, JSON.stringify(data).slice(0,80));
    if (isNew) {
      const res = await sbFetch(table, 'POST', { data });
      if (res && res[0] && res[0].id) {
        const newId = res[0].id;
        record.id = newId;
        console.log('[sbSave] POST ok, new id:', newId);
        // Update the matching record in the correct array with the Supabase id
        const arrMap = {
          alg_employees:  employees,
          alg_corporates: corporates,
          alg_projects:   projects,
          alg_vendors:    vendors,
          alg_expenses:   expenses,
        };
        const arr = arrMap[table];
        if (arr) {
          // Find by old local id (the one we just stripped out as `id`)
          const localIdx = arr.findIndex(x => x.id === id || x === record);
          if (localIdx >= 0) arr[localIdx].id = newId;
        }
      }
    } else {
      const res = await sbFetch(table, 'PATCH', { data }, `?id=eq.${id}`);
      console.log('[sbSave] PATCH ok, rows affected:', res ? res.length : 0);
    }
    showSyncStatus('ok');
  } catch(e) {
    console.error('[sbSave] error:', e.message, 'table:', table, 'id:', id);
    showSyncStatus('error', e.message);
  }
}

async function sbUpsert(table, record) {
  return sbSave(table, record);
}

async function sbDelete(table, id) {
  try {
    showSyncStatus('syncing');
    await sbFetch(table, 'DELETE', null, `?id=eq.${id}`);
    showSyncStatus('ok');
  } catch(e) {
    console.error('sbDelete error:', e);
    showSyncStatus('error', e.message);
  }
}

// Sync status indicator
function showSyncStatus(state, msg='') {
  const el = document.getElementById('sync-status');
  if (!el) return;
  const states = {
    syncing: { icon:'⟳', color:'rgba(255,255,255,.5)', text:'Sincronizando…' },
    ok:      { icon:'✓', color:'#26a65b',              text:'Guardado'       },
