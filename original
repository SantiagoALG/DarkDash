    const probColor = q.prob >= 75 ? 'var(--green)' : q.prob >= 50 ? 'var(--gold)' : 'var(--accent-2)';
    const totalHrsQ  = (q.assignments||[]).reduce((s,a)=>s+(a.hrs||0),0);
