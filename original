}

function updateEePreview() {
  const base        = parseFloat(document.getElementById('ee-salary').value)   || 0;
  const oh          = parseFloat(document.getElementById('ee-overhead').value)  ?? OVERHEAD_RATE;
  const utilPct     = parseFloat(document.getElementById('ee-util').value)      ?? 50;
  const utilRate    = utilPct / 100;

  // Fórmula idéntica al Cotizador:
  // 1. costoDir + overhead = costoTotal (sin IVA)
  // 2. precioSinIva = costoTotal / (1 - util)
  // 3. precioConIva = precioSinIva × 1.16
  const overheadAmt  = base * oh;
  const costoTotal   = base + overheadAmt;                                    // sin IVA
  const ivaAlg       = costoTotal * IVA;                                      // IVA sobre costo ALG
  const costoConIva  = costoTotal + ivaAlg;                                   // lo que cuesta a ALG
  const precioSinIva = utilRate < 1 ? costoTotal / (1 - utilRate) : costoTotal * 2;
  const precioConIva = precioSinIva * (1 + IVA);                              // lo que se cobra al cliente

  document.getElementById('ee-base-preview').textContent     = fmt(base);
  document.getElementById('ee-overhead-label').textContent   = oh + '×';
  document.getElementById('ee-overhead-preview').textContent = fmt(overheadAmt);
  document.getElementById('ee-iva-preview').textContent      = fmt(ivaAlg);
  document.getElementById('ee-total-preview').textContent    = fmt(costoConIva);
  document.getElementById('ee-util-label').textContent       = utilPct + '%';
  document.getElementById('ee-precio-preview').textContent     = fmt(precioSinIva);
  const precioIvaEl = document.getElementById('ee-precio-iva-preview');
  if (precioIvaEl) precioIvaEl.textContent = fmt(precioConIva);
}

document.getElementById('ee-salary').addEventListener('input', updateEePreview);

function saveEditEmployee() {
  if (_editEmpId === null) return;
  const name   = document.getElementById('ee-name').value.trim();
  const role   = document.getElementById('ee-role').value.trim();
  const salary = parseFloat(document.getElementById('ee-salary').value) || 0;
  const type   = document.getElementById('ee-type').value;

  if (!name) { showToast('Escribe el nombre'); return; }

  // Determine new categories
  const isBillable  = type === 'billable' || type === 'combined';
  const isCorporate = type === 'corporate' || type === 'combined';
  const isCombined  = type === 'combined';

  // Remove from both lists first
  employees  = employees.filter(e => e.id !== _editEmpId);
  corporates = corporates.filter(c => c.id !== _editEmpId);

  const overhead = parseFloat(document.getElementById('ee-overhead').value) ?? OVERHEAD_RATE;
  const util     = parseFloat(document.getElementById('ee-util').value)     ?? 50;
  const base = { id: _editEmpId, name, role, salary, overhead, util, implant: _editIsImplant, _combined: isCombined };

  if (isBillable)  employees.push({...base});
  if (isCorporate) corporates.push({...base, _combined: isCombined});

  closeModal('edit-employee');
  renderAll();
  showToast(`${name} actualizado ✓`);
  if (SUPABASE_READY) {
    const updEmp  = employees.find(e => e.id === _editEmpId);
    const updCorp = corporates.find(c => c.id === _editEmpId);
    if (updEmp)  sbSave('alg_employees',  updEmp);
    if (updCorp) sbSave('alg_corporates', updCorp);
  }
}

