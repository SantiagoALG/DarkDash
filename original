    'th{padding:6px 10px;text-align:left;font-size:8.5px;text-transform:uppercase;letter-spacing:.05em;font-weight:700;}',
    'th.r{text-align:right;}',
    'td{padding:6px 10px;border-bottom:1px solid #e3e1d8;vertical-align:middle;}',
    'td.r{text-align:right;font-family:"DM Mono",monospace;font-size:10px;}',
    'tr:last-child td{border-bottom:none;}',
    'tr.total-row td{font-weight:700;background:#f2f2f2;border-top:2px solid #0f1117;}',
    'tr.sub-row td{background:#f8f7f4;font-weight:600;}',
    '.section-box{border:1px solid #e3e1d8;border-radius:8px;overflow:hidden;margin-bottom:20px;}',
    '.bar-wrap{background:#e3e1d8;border-radius:3px;height:5px;margin-top:4px;overflow:hidden;}',
    '.bar-fill{height:100%;border-radius:3px;}',
    '.pill{display:inline-block;font-size:8px;font-weight:700;padding:2px 7px;border-radius:20px;letter-spacing:.03em;}',
    '.pill-green{background:#e8f4ed;color:#1a6b3c;}',
    '.pill-blue{background:#e8f0fe;color:#1a3a8f;}',
    '.pill-gold{background:rgba(200,151,42,.15);color:#c8972a;}',
    '.pill-amber{background:#fff8f0;color:#b45309;}',
    '.pill-gray{background:#efeee9;color:#7a7f94;}',
    '.sum-grid{display:grid;grid-template-columns:repeat(3,1fr);}',
    '.sum-cell{padding:12px 16px;border-right:1px solid #e3e1d8;}',
    '.sum-cell:last-child{border-right:none;}',
    '.sum-label{font-size:8px;font-weight:700;text-transform:uppercase;letter-spacing:.08em;color:#7a7f94;margin-bottom:4px;}',
    '.sum-val{font-family:"DM Mono",monospace;font-size:15px;}',
    '.sum-sub{font-size:8.5px;color:#7a7f94;margin-top:3px;}',
    '.cap-row{display:grid;grid-template-columns:130px 1fr 60px 50px;gap:8px;align-items:center;padding:5px 0;border-bottom:1px solid #e3e1d8;}',
    '.cap-row:last-child{border-bottom:none;}',
    '.footer{margin-top:32px;padding-top:10px;border-top:1px solid #e3e1d8;font-size:9px;color:#7a7f94;display:flex;justify-content:space-between;align-items:center;}',
    '@media print{body{padding:20px;}@page{margin:15mm;size:A4;}}',
  ].join('\n');

  // ── 1. Executive Summary ──────────────────────────────
  const kpiHTML = '<div class="kpi-row">'
    + '<div class="kpi"><div class="kpi-label">Ingresos totales (c/IVA)</div><div class="kpi-val gold">' + fmt(incomeTot) + '</div><div class="kpi-sub">Base ' + fmt(incomeBase) + ' + IVA ' + fmt(incomeIva) + '</div></div>'
    + '<div class="kpi"><div class="kpi-label">Egresos totales</div><div class="kpi-val">' + fmt(totalEg) + '</div><div class="kpi-sub">Nómina + proveedores + gastos</div></div>'
    + '<div class="kpi"><div class="kpi-label">Margen neto</div><div class="kpi-val ' + (netMargin >= 0 ? 'green' : 'red') + '">' + fmt(netMargin) + '</div><div class="kpi-sub">' + netMPct + '% del ingreso total</div></div>'
    + '<div class="kpi"><div class="kpi-label">Proyectos activos</div><div class="kpi-val">' + projects.length + '</div><div class="kpi-sub">' + employees.length + ' colaboradores</div></div>'
    + '</div>'
    + '<div style="margin-top:14px;background:#0f1117;color:#fff;border-radius:8px;overflow:hidden">'
    + '<div class="sum-grid">'
    + '<div class="sum-cell"><div class="sum-label" style="color:rgba(255,255,255,.4)">Nómina + IVA</div><div class="sum-val">' + fmt(payrollTot) + '</div><div class="sum-sub" style="color:rgba(255,255,255,.4)">Base ' + fmt(payrollBase) + ' · IVA ' + fmt(payrollIva) + '</div></div>'
    + '<div class="sum-cell"><div class="sum-label" style="color:rgba(255,255,255,.4)">Gastos operativos</div><div class="sum-val">' + fmt(expTotal) + '</div><div class="sum-sub" style="color:rgba(255,255,255,.4)">' + expenses.length + ' conceptos</div></div>'
    + '<div class="sum-cell"><div class="sum-label" style="color:rgba(255,255,255,.4)">Proveedores</div><div class="sum-val">' + fmt(vendorCostT) + '</div><div class="sum-sub" style="color:rgba(255,255,255,.4)">' + vendors.length + ' proveedor(es)</div></div>'
    + '</div></div>';

  // ── 2. Income by project ──────────────────────────────
  let projRows = '';
  projects.forEach(function(p) {
    const inc    = incomeInMXN(p);
    const incIva = inc * (1 + IVA);
    const cost   = getProjectTeamCost(p) * (1 + IVA);
    const vCost  = vendors.filter(function(v){return v.projectId===p.id&&isVendorActive(v);}).reduce(function(s,v){return s+(v.cost||0);},0);
    const margin = incIva - cost - vCost;
    const mPct   = incIva > 0 ? (margin/incIva*100).toFixed(1) : '--';
    const tCls   = p.type==='iguala' ? 'pill-blue' : 'pill-gold';
    const tLbl   = p.type==='iguala' ? 'Iguala' : 'Único';
    projRows += '<tr>'
      + '<td><strong>' + p.name + '</strong><br><span style="font-size:9px;color:#7a7f94">' + (p.client||'') + '</span></td>'
      + '<td><span class="pill ' + tCls + '">' + tLbl + '</span></td>'
      + '<td class="r">' + (p.currency==='USD' ? fmtUSD(p.income||0) : '') + '</td>'
      + '<td class="r">' + fmt(inc) + '</td>'
      + '<td class="r" style="color:#1a6b3c;font-weight:600">' + fmt(incIva) + '</td>'
      + '<td class="r">' + fmt(cost) + '</td>'
      + '<td class="r" style="color:' + (margin>=0?'#1a6b3c':'#e8312a') + ';font-weight:600">' + fmt(margin) + '</td>'
      + '<td class="r" style="color:' + (margin>=0?'#1a6b3c':'#e8312a') + '">' + (mPct !== '--' ? mPct+'%' : '--') + '</td>'
      + '</tr>';
  });
  const totInc  = projects.reduce(function(s,p){return s+incomeInMXN(p)*(1+IVA);},0);
  const totCost = projects.reduce(function(s,p){return s+getProjectTeamCost(p)*(1+IVA);},0);
  const totVend = vendors.reduce(function(s,v){return s+(v.cost||0);},0);
  const totMarg = totInc - totCost - totVend;
  const totRow  = '<tr class="total-row"><td colspan="4">TOTAL</td>'
    + '<td class="r">' + fmt(totInc) + '</td>'
    + '<td class="r">' + fmt(totCost) + '</td>'
    + '<td class="r" style="color:' + (totMarg>=0?'#1a6b3c':'#e8312a') + '">' + fmt(totMarg) + '</td>'
    + '<td class="r">' + (totInc>0?(totMarg/totInc*100).toFixed(1)+'%':'--') + '</td></tr>';

  const incomeHTML = '<div class="section-box"><table>'
    + '<thead><tr><th>Proyecto</th><th>Tipo</th><th class="r">USD</th><th class="r">Base MXN</th><th class="r">Con IVA</th><th class="r">Costo equipo</th><th class="r">Margen</th><th class="r">%</th></tr></thead>'
    + '<tbody>' + projRows + '</tbody><tfoot>' + totRow + '</tfoot></table></div>';

  // ── 3. Profitability bars ─────────────────────────────
  const maxInc2 = Math.max.apply(null, projects.map(function(p){return incomeInMXN(p)*(1+IVA);})) || 1;
  let profitRows = '';
  projects.forEach(function(p) {
    const inc2   = incomeInMXN(p)*(1+IVA);
    const cost2  = getProjectTeamCost(p)*(1+IVA) + vendors.filter(function(v){return v.projectId===p.id&&isVendorActive(v);}).reduce(function(s,v){return s+(v.cost||0);},0);
    const margin2= inc2 - cost2;
    const mPct2  = inc2 > 0 ? (margin2/inc2*100).toFixed(1) : '0';
    const incW   = (inc2/maxInc2*100).toFixed(1);
    const costW  = Math.min(cost2/maxInc2*100, 100).toFixed(1);
    const mCol   = margin2>=0 ? '#1a6b3c' : '#e8312a';
    profitRows += '<div class="cap-row" style="grid-template-columns:140px 1fr 80px 60px">'
      + '<div><div style="font-size:10px;font-weight:600">' + p.name + '</div><div style="font-size:8.5px;color:#7a7f94">' + (p.client||'') + '</div></div>'
      + '<div><div class="bar-wrap" style="height:7px;position:relative">'
      + '<div class="bar-fill" style="width:' + incW + '%;background:#1a6b3c;position:absolute;top:0;left:0;height:100%"></div>'
      + '<div class="bar-fill" style="width:' + costW + '%;background:#e8312a;opacity:.45;position:absolute;top:0;left:0;height:100%"></div>'
      + '</div><div style="display:flex;justify-content:space-between;margin-top:2px"><span style="font-size:8px;color:#1a6b3c">Ingreso ' + fmt(inc2) + '</span><span style="font-size:8px;color:#7a7f94">Costo ' + fmt(cost2) + '</span></div></div>'
      + '<div style="font-family:\'DM Mono\',monospace;font-size:10px;font-weight:600;text-align:right;color:' + mCol + '">' + fmt(margin2) + '</div>'
      + '<div style="font-size:10px;font-weight:700;text-align:right;color:' + mCol + '">' + mPct2 + '%</div>'
      + '</div>';
  });
  const profitHTML = '<div class="section-box" style="padding:14px 16px">' + (profitRows || '<p style="font-size:10px;color:#7a7f94">Sin proyectos.</p>') + '</div>';

  // ── 4. Payroll ────────────────────────────────────────
  const corpOnly2  = corporates.filter(function(c){return !c._combined;});
  const allPeople2 = employees.map(function(e){
    const isComb = corporates.some(function(c){return c.id===e.id&&c._combined;});
    return Object.assign({}, e, {_cat: isComb?'combinado':'facturable'});
  }).concat(corpOnly2.map(function(c){return Object.assign({},c,{_cat:'corporativo'});}));

  let payrollRows = '';
  allPeople2.forEach(function(p) {
    const base  = p.salary||0;
    const iva2  = base * IVA;
    const total = base + iva2;
    const hrsA  = p._cat!=='corporativo' ? getEmployeeAssignedHrs(p.id) : 0;
    const capPct= hrsA > 0 ? (hrsA/CAP*100).toFixed(0)+'%' : '--';
    const catMap= {facturable:'Facturable',combinado:'Combinado',corporativo:'Corporativo'};
    const clsMap= {facturable:'pill-green',combinado:'pill-amber',corporativo:'pill-gray'};
    payrollRows += '<tr>'
      + '<td><strong>' + p.name + '</strong>' + (p.role ? '<br><span style="font-size:9px;color:#7a7f94">'+p.role+'</span>' : '') + '</td>'
      + '<td><span class="pill ' + (clsMap[p._cat]||'pill-gray') + '">' + (catMap[p._cat]||p._cat) + '</span></td>'
      + '<td class="r">' + fmt(base) + '</td>'
      + '<td class="r" style="color:#b45309">' + fmt(iva2) + '</td>'
      + '<td class="r" style="font-weight:600">' + fmt(total) + '</td>'
      + '<td class="r">' + (hrsA>0?hrsA.toFixed(0)+' hrs':'--') + '</td>'
      + '<td class="r">' + capPct + '</td>'
      + '</tr>';
  });
  const payTotBase = allPeople2.reduce(function(s,p){return s+(p.salary||0);},0);
  payrollRows += '<tr class="total-row"><td colspan="2">TOTAL NÓMINA</td>'
    + '<td class="r">' + fmt(payTotBase) + '</td>'
    + '<td class="r" style="color:#b45309">' + fmt(payTotBase*IVA) + '</td>'
    + '<td class="r">' + fmt(payTotBase*(1+IVA)) + '</td>'
    + '<td colspan="2"></td></tr>';

  const payrollHTML = '<div class="section-box"><table>'
    + '<thead><tr><th>Colaborador</th><th>Tipo</th><th class="r">Honorarios</th><th class="r">IVA 16%</th><th class="r">Total</th><th class="r">Hrs asig.</th><th class="r">% Cap.</th></tr></thead>'
    + '<tbody>' + payrollRows + '</tbody></table></div>';

  // ── 5. Expenses ───────────────────────────────────────
  const EXP_LABELS = {suscripcion:'Suscripción',servicios:'Servicios',renta:'Renta',varios:'Varios'};
  let expRows = '';
  expenses.forEach(function(e) {
    const total2 = expenseTotal(e);
    expRows += '<tr>'
      + '<td><span class="pill ' + (e.cat==='suscripcion'?'pill-blue':e.cat==='servicios'?'pill-gray':e.cat==='renta'?'pill-gold':'pill-gray') + '">' + (EXP_LABELS[e.cat]||e.cat) + '</span></td>'
      + '<td>' + (e.desc||'--') + '</td>'
      + '<td class="r">' + fmt(e.amount||0) + '</td>'
      + '<td style="text-align:center">' + (e.hasIva?'✓':'') + '</td>'
      + '<td class="r" style="font-weight:600">' + fmt(total2) + '</td>'
      + '<td><span class="pill ' + (e.recurrent?'pill-green':'pill-gray') + '">' + (e.recurrent?'Fijo':'Variable') + '</span></td>'
      + '</tr>';
  });
  const expCats = ['suscripcion','servicios','renta','varios'];
  expCats.forEach(function(cat) {
    const t3 = totalExpenses(cat);
    if (!t3) return;
    const lst = expenses.filter(function(e){return e.cat===cat;});
    expRows += '<tr class="sub-row"><td>' + (EXP_LABELS[cat]||cat) + '</td><td>' + lst.length + ' concepto(s)</td>'
      + '<td class="r">' + fmt(lst.reduce(function(s,e){return s+(e.amount||0);},0)) + '</td>'
      + '<td></td><td class="r">' + fmt(t3) + '</td><td></td></tr>';
  });
  expRows += '<tr class="total-row"><td colspan="4">TOTAL GASTOS OPERATIVOS</td><td class="r">' + fmt(expTotal) + '</td><td></td></tr>';

  const expHTML = expenses.length
    ? '<div class="section-box"><table>'
      + '<thead><tr><th>Categoría</th><th>Concepto</th><th class="r">Base</th><th style="text-align:center">IVA</th><th class="r">Total</th><th>Tipo</th></tr></thead>'
      + '<tbody>' + expRows + '</tbody></table></div>'
    : '<p style="font-size:10px;color:#7a7f94;padding:8px 0">Sin gastos registrados.</p>';

  // ── 6. Team capacity ──────────────────────────────────
  let capRows = '';
  employees.forEach(function(emp) {
    const hrs3   = getEmployeeAssignedHrs(emp.id);
    const pctMax = hrs3 / CAP_MAX;
    const color3 = hrs3 > CAP_MAX ? '#e8312a' : hrs3 > CAP ? '#c8972a' : '#1a3a8f';
    capRows += '<div class="cap-row">'
      + '<div><span style="font-size:10px;font-weight:600">' + emp.name + '</span>' + (emp.role ? '<span style="font-size:8.5px;color:#7a7f94;margin-left:5px">' + emp.role + '</span>' : '') + '</div>'
      + '<div style="position:relative"><div class="bar-wrap"><div class="bar-fill" style="width:' + Math.min(pctMax,1)*100 + '%;background:' + color3 + '"></div></div></div>'
      + '<div style="font-family:\'DM Mono\',monospace;font-size:9.5px;text-align:right;color:' + color3 + '">' + hrs3.toFixed(0) + '/' + CAP + 'h</div>'
      + '<div style="font-size:9px;color:#7a7f94;text-align:right">' + (hrs3/CAP*100).toFixed(0) + '%</div>'
      + '</div>';
  });
  const capHTML = '<div class="section-box" style="padding:14px 16px">'
    + '<div style="display:flex;gap:16px;margin-bottom:10px">'
    + '<div style="display:flex;align-items:center;gap:5px"><div style="width:8px;height:8px;border-radius:2px;background:#1a3a8f"></div><span style="font-size:8.5px;color:#7a7f94">≤120 hrs</span></div>'
    + '<div style="display:flex;align-items:center;gap:5px"><div style="width:8px;height:8px;border-radius:2px;background:#c8972a"></div><span style="font-size:8.5px;color:#7a7f94">121–140 hrs</span></div>'
    + '<div style="display:flex;align-items:center;gap:5px"><div style="width:8px;height:8px;border-radius:2px;background:#e8312a"></div><span style="font-size:8.5px;color:#7a7f94">>140 hrs</span></div>'
    + '</div>'
    + (capRows || '<p style="font-size:10px;color:#7a7f94">Sin colaboradores.</p>')
    + '</div>';

  // ── Assemble ──────────────────────────────────────────
  const parts = [
    '<!DOCTYPE html><html lang="es"><head><meta charset="UTF-8">',
    '<title>Reporte ALG ' + monthLabel + '</title>',
    '<style>' + CSS + '</style></head><body>',
    '<div style="display:flex;justify-content:space-between;align-items:flex-start;margin-bottom:20px;padding-bottom:16px;border-bottom:2px solid #0f1117">',
    '<div><div style="font-size:11px;font-weight:700;text-transform:uppercase;letter-spacing:.1em;color:#c8972a;margin-bottom:4px">ALG Agency</div>',
    '<h1>Reporte Mensual</h1><div style="font-size:12px;color:#7a7f94;margin-top:4px;text-transform:capitalize">' + monthLabel + '</div></div>',
    '<div style="text-align:right;font-size:9px;color:#7a7f94">',
    '<div>Documento interno — uso exclusivo dirección</div>',
    '<div style="margin-top:3px">Generado: ' + new Date().toLocaleDateString('es-MX',{day:'numeric',month:'long',year:'numeric'}) + '</div>',
    '<div style="margin-top:3px;font-family:\'DM Mono\',monospace;font-size:8px">TC: $' + getTC().toFixed(2) + ' MXN/USD</div>',
    '</div></div>',
    '<h2>1 — Resumen ejecutivo</h2>' + kpiHTML,
    '<h2>2 — Ingresos por proyecto</h2>' + incomeHTML,
    '<h2>3 — Rentabilidad por proyecto</h2>' + profitHTML,
    '<h2>4 — Nómina + IVA por colaborador</h2>' + payrollHTML,
    '<h2>5 — Gastos operativos</h2>' + expHTML,
    '<h2>6 — Carga del equipo</h2>' + capHTML,
    '<div class="footer">',
    '<span>ALG Agency · Reporte interno · ' + monthLabel + '</span>',
    '<span style="font-family:\'DM Mono\',monospace">Ingresos ' + fmt(incomeTot) + ' · Egresos ' + fmt(totalEg) + ' · Margen ' + fmt(netMargin) + ' (' + netMPct + '%)</span>',
    '</div>',
    '<scr'+'ipt>window.onload=function(){window.print();}<\/scr'+'ipt>',
    '</body></html>',
  ];
  const html = parts.join('\n');

  const w = window.open('', '_blank');
  if (!w) { showToast('Permite pop-ups para generar el reporte'); return; }
  w.document.write(html);
  w.document.close();
}

function showToast(msg) {
  const t = document.getElementById('toast');
  t.textContent = msg;
  t.classList.add('show');
  clearTimeout(t._t);
  t._t = setTimeout(() => t.classList.remove('show'), 2800);
}

// ══════════════════════════════════════════════════════
// INIT — datos limpios (cargar desde Supabase)
// ══════════════════════════════════════════════════════
const _combined = [];

employees  = [];
corporates = [];
projects   = [];
vendors    = [];
expenses   = [];

// ── BOOT ──────────────────────────────────────────────
if (SUPABASE_READY) {
  loadFromSupabase();
} else {
  showSyncStatus('offline');
  renderAll();
}

</script>
</body>
</html>
