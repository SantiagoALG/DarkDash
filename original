<!DOCTYPE html>
<html lang="es">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>ALG | Dashboard</title>
<link href="https://api.fontshare.com/v2/css?f[]=monument-grotesk@400,500,700,900&display=swap" rel="stylesheet">
<link href="https://fonts.googleapis.com/css2?family=DM+Mono:wght@400;500&display=swap" rel="stylesheet">
<style>
/* ── RESET ── */
*, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
html { font-size: 15px; }
body {
  font-family: 'Monument Grotesk', sans-serif;
  background: #f2ede4;
  color: #111111;
  min-height: 100vh;
  -webkit-font-smoothing: antialiased;
}

/* ── VARIABLES ── */
:root {
  --beige:     #f2ede4;
  --bone:      #e8e2d6;
  --bone-2:    #ddd7c9;
  --rule:      #c8c2b4;
  --rule-heavy:#9e9888;
  --ink:       #111111;
  --ink-mid:   #555555;
  --ink-soft:  #999999;
  --gold:      #c8972a;
  --green:     #1a7a40;
  --red:       #c0392b;
  --mono:      'DM Mono', monospace;
  --sans:      'Monument Grotesk', sans-serif;
}

/* ── HEADER ── */
header {
  background: var(--ink);
  height: 52px;
  display: flex; align-items: center;
  padding: 0 0 0 32px;
  position: sticky; top: 0; z-index: 200;
  border-bottom: 2px solid var(--gold);
}
.logo {
  font-weight: 900; font-size: 1rem;
  color: #fff; letter-spacing: .08em;
  text-transform: uppercase;
  display: flex; align-items: center; gap: 0;
}
.logo-pipe {
  width: 1px; height: 16px;
  background: var(--gold);
  margin: 0 12px;
}
.logo-sub {
  font-weight: 400; font-size: .72rem;
  color: var(--gold); letter-spacing: .18em;
  text-transform: uppercase;
}
header nav {
  display: flex; margin-left: 40px; height: 52px;
}
header nav button {
  background: transparent; border: none;
  color: rgba(255,255,255,.45);
  padding: 0 20px; height: 52px;
  font-family: var(--sans); font-size: .72rem;
  font-weight: 500; letter-spacing: .06em;
  text-transform: uppercase;
  cursor: pointer; transition: color .15s;
  border-bottom: 2px solid transparent;
  margin-bottom: -2px;
}
header nav button:hover { color: rgba(255,255,255,.8); }
header nav button.active { color: var(--gold); border-bottom-color: var(--gold); }
.header-right {
  margin-left: auto;
  display: flex; align-items: center; gap: 20px;
  padding-right: 32px;
}
.header-right label {
  font-size: .6rem; color: rgba(255,255,255,.35);
  text-transform: uppercase; letter-spacing: .1em;
  font-family: var(--mono);
}
.header-right input {
  background: rgba(255,255,255,.07);
  border: 1px solid rgba(255,255,255,.12);
  color: rgba(255,255,255,.8);
  font-family: var(--mono); font-size: .75rem;
  padding: 4px 8px;
}
.header-right input:focus { outline: none; border-color: var(--gold); }
#sync-status { font-family: var(--mono); font-size: .65rem; }

/* ── NAV PAGES ── */
.page { display: none; }
.page.active { display: block; }

/* ── DASHBOARD GRID ── */
.dash-grid {
  display: grid;
  grid-template-columns: repeat(12, 1fr);
  grid-auto-rows: auto;
  border-left: 1px solid var(--rule);
  border-top: 1px solid var(--rule);
}
.cell {
  border-right: 1px solid var(--rule);
  border-bottom: 1px solid var(--rule);
  background: var(--beige);
  position: relative;
  overflow: hidden;
}
.cell:nth-child(even) { background: var(--bone); }
.cell-label {
  font-size: .55rem; font-weight: 700;
  text-transform: uppercase; letter-spacing: .12em;
  color: var(--ink-soft);
  padding: 10px 14px 4px;
  display: block;
}
.cell-val {
  font-family: var(--mono);
  font-size: 1.6rem; font-weight: 400;
  color: var(--ink); line-height: 1;
  padding: 0 14px 8px;
}
.cell-val.green { color: var(--green); }
.cell-val.red   { color: var(--red); }
.cell-val.gold  { color: var(--gold); }
.cell-sub {
  font-size: .65rem; color: var(--ink-soft);
  font-family: var(--mono);
  padding: 0 14px 10px;
}

/* KPI cells — span 3 cols each */
.cell-kpi { grid-column: span 3; padding-bottom: 4px; }

/* Section title cell */
.cell-title {
  grid-column: span 12;
  background: var(--ink) !important;
  padding: 10px 20px;
  display: flex; align-items: baseline; gap: 14px;
}
.cell-title h2 {
  font-size: .65rem; font-weight: 700;
  text-transform: uppercase; letter-spacing: .14em;
  color: var(--gold);
}
.cell-title small {
  font-size: .6rem; color: rgba(255,255,255,.3);
  letter-spacing: .06em;
}

/* Projects row */
.cell-proj {
  grid-column: span 4;
  cursor: pointer;
  transition: background .12s;
}
.cell-proj:hover { background: var(--bone-2) !important; }
.cell-proj-name {
  font-weight: 700; font-size: .9rem;
  padding: 12px 14px 4px;
  display: flex; align-items: center; gap: 8px;
}
.cell-proj-bar {
  width: 3px; height: 16px; border-radius: 0; flex-shrink: 0;
}
.cell-proj-meta {
  font-size: .68rem; color: var(--ink-soft);
  padding: 0 14px;
  font-family: var(--mono);
}
.cell-proj-income {
  font-family: var(--mono); font-size: 1.1rem;
  font-weight: 400; color: var(--ink);
  padding: 6px 14px 12px;
}

/* Financial summary cells */
.cell-fin { grid-column: span 4; }
.cell-fin-wide { grid-column: span 6; }

/* Team capacity cell */
.cell-capacity { grid-column: span 12; padding: 16px 20px; }
.cap-grid {
  display: grid;
  grid-template-columns: repeat(auto-fill, minmax(160px, 1fr));
  gap: 0;
  border: 1px solid var(--rule);
  border-right: none; border-bottom: none;
}
.cap-member {
  border-right: 1px solid var(--rule);
  border-bottom: 1px solid var(--rule);
  padding: 10px 12px;
  cursor: pointer;
  transition: background .12s;
}
.cap-member:hover { background: var(--bone-2); }
.cap-member-name {
  font-size: .75rem; font-weight: 700;
  display: flex; align-items: center; gap: 7px;
  margin-bottom: 6px;
}
.cap-bar-wrap {
  height: 3px; background: var(--rule);
  position: relative; overflow: hidden;
}
.cap-bar-fill {
  position: absolute; left: 0; top: 0; height: 100%;
  transition: width .4s ease;
}
.cap-pct {
  font-family: var(--mono); font-size: .6rem;
  color: var(--ink-soft); margin-top: 4px;
}

/* ── POPOVER ── */
.popover {
  position: fixed; z-index: 500;
  background: var(--ink); color: #fff;
  border: 1px solid rgba(255,255,255,.1);
  border-top: 2px solid var(--gold);
  padding: 16px 18px; min-width: 220px; max-width: 320px;
  pointer-events: none;
  opacity: 0; transform: translateY(4px);
  transition: opacity .15s, transform .15s;
  font-size: .78rem; line-height: 1.6;
}
.popover.show {
  opacity: 1; transform: translateY(0);
  pointer-events: auto;
}
.popover-title {
  font-size: .6rem; font-weight: 700;
  text-transform: uppercase; letter-spacing: .1em;
  color: var(--gold); margin-bottom: 10px;
}
.popover-row {
  display: flex; justify-content: space-between;
  gap: 16px; padding: 3px 0;
  border-bottom: 1px solid rgba(255,255,255,.06);
}
.popover-row:last-child { border-bottom: none; }
.popover-key { color: rgba(255,255,255,.5); font-size: .72rem; }
.popover-val { font-family: var(--mono); font-size: .75rem; }

/* ── SECTION PAGES (non-dashboard) ── */
.section-page { padding: 0; }
.section-table-wrap { overflow-x: auto; }
.stbl {
  width: 100%; border-collapse: collapse;
  border-left: 1px solid var(--rule);
}
.stbl th {
  font-size: .6rem; font-weight: 700;
  text-transform: uppercase; letter-spacing: .1em;
  color: var(--ink-soft); padding: 10px 16px;
  text-align: left; background: var(--bone);
  border-right: 1px solid var(--rule);
  border-bottom: 2px solid var(--rule-heavy);
  white-space: nowrap;
}
.stbl th.r { text-align: right; }
.stbl td {
  padding: 10px 16px;
  border-right: 1px solid var(--rule);
  border-bottom: 1px solid var(--rule);
  font-size: .82rem; vertical-align: middle;
}
.stbl td.r { text-align: right; font-family: var(--mono); font-size: .78rem; }
.stbl tr:hover td { background: var(--bone); }
.stbl tr:last-child td { border-bottom: none; }
.stbl tfoot td {
  font-weight: 700; background: var(--bone-2) !important;
  border-top: 2px solid var(--rule-heavy);
}

/* Page header bar */
.page-bar {
  background: var(--bone);
  border-bottom: 2px solid var(--rule-heavy);
  padding: 14px 24px;
  display: flex; align-items: center; justify-content: space-between;
  gap: 16px;
}
.page-bar h1 {
  font-size: .9rem; font-weight: 900;
  text-transform: uppercase; letter-spacing: .1em;
  display: flex; align-items: center; gap: 10px;
}
.page-bar h1 small {
  font-weight: 400; font-size: .7rem;
  color: var(--ink-soft); text-transform: none; letter-spacing: 0;
}

/* Buttons */
.btn {
  background: var(--ink); color: #fff;
  border: none; padding: 8px 18px;
  font-family: var(--sans); font-size: .72rem;
  font-weight: 700; letter-spacing: .06em;
  text-transform: uppercase; cursor: pointer;
  transition: background .15s;
}
.btn:hover { background: #333; }
.btn.gold { background: var(--gold); color: var(--ink); }
.btn.gold:hover { opacity: .85; }
.btn.ghost {
  background: transparent; color: var(--ink-soft);
  border: 1px solid var(--rule);
}
.btn.ghost:hover { border-color: var(--rule-heavy); color: var(--ink); }
.btn.danger { background: transparent; color: var(--red); border: 1px solid var(--red); }
.btn.danger:hover { background: var(--red); color: #fff; }

/* Badges */
.badge {
  display: inline-block;
  font-size: .6rem; font-weight: 700;
  padding: 2px 7px;
  text-transform: uppercase; letter-spacing: .05em;
  font-family: var(--sans);
}
.badge.ok     { background: rgba(26,122,64,.12);  color: var(--green); }
.badge.warn   { background: rgba(200,151,42,.15); color: var(--gold); }
.badge.over   { background: rgba(192,57,43,.12);  color: var(--red); }
.badge.idle   { background: rgba(0,0,0,.06);       color: var(--ink-soft); }
.badge.fixed  { background: rgba(200,151,42,.12); color: var(--gold); }
.badge.oneshot{ background: rgba(0,0,0,.06);       color: var(--ink-soft); }

/* Avatar */
.avatar {
  width: 26px; height: 26px;
  display: inline-flex; align-items: center; justify-content: center;
  font-size: .6rem; font-weight: 700; flex-shrink: 0;
  letter-spacing: .02em;
}

/* Modals */
.modal-overlay {
  display: none; position: fixed; inset: 0;
  background: rgba(17,17,17,.55);
  z-index: 800; align-items: center; justify-content: center;
}
.modal-overlay.open { display: flex; }
.modal {
  background: var(--beige);
  border: 1px solid var(--rule);
  border-top: 3px solid var(--ink);
  padding: 32px; width: 540px;
  max-width: 94vw; max-height: 90vh; overflow-y: auto;
  animation: mIn .18s ease;
}
@keyframes mIn { from{opacity:0;transform:translateY(10px)} to{opacity:1;transform:none} }
.modal h3 {
  font-size: .82rem; font-weight: 900;
  text-transform: uppercase; letter-spacing: .12em;
  margin-bottom: 24px; padding-bottom: 14px;
  border-bottom: 1px solid var(--rule);
}
.field-row { display: grid; grid-template-columns: 1fr 1fr; gap: 14px; margin-bottom: 14px; }
.field-group { display: flex; flex-direction: column; gap: 5px; }
.field-group label {
  font-size: .6rem; font-weight: 700;
  text-transform: uppercase; letter-spacing: .1em; color: var(--ink-soft);
}
.field-group input, .field-group select, .field-group textarea {
  border: 1px solid var(--rule);
  background: #fff;
  padding: 9px 12px; font-family: var(--mono); font-size: .82rem; color: var(--ink);
  transition: border-color .12s; appearance: none;
}
.field-group input:focus, .field-group select:focus, .field-group textarea:focus {
  outline: none; border-color: var(--ink);
}
.modal-footer {
  display: flex; gap: 10px; justify-content: flex-end; margin-top: 24px;
  padding-top: 16px; border-top: 1px solid var(--rule);
}

/* Expense table inline edit */
.exp-input {
  border: none; background: transparent;
  font-family: var(--mono); font-size: .78rem; color: var(--ink);
  width: 100%; padding: 0;
}
.exp-input:focus { outline: none; }
.exp-select {
  border: none; background: transparent;
  font-family: var(--sans); font-size: .78rem; color: var(--ink);
  cursor: pointer; width: 100%;
}
.exp-select:focus { outline: none; }
.exp-check {
  width: 16px; height: 16px; cursor: pointer; accent-color: var(--ink);
}

/* Financial summary bar */
.fin-bar {
  display: grid;
  border-left: 1px solid var(--rule);
  border-top: 1px solid var(--rule);
}
.fin-bar-cell {
  border-right: 1px solid var(--rule);
  border-bottom: 1px solid var(--rule);
  padding: 16px 20px;
}
.fin-bar-label {
  font-size: .58rem; font-weight: 700;
  text-transform: uppercase; letter-spacing: .1em;
  color: var(--ink-soft); margin-bottom: 8px;
}
.fin-bar-val {
  font-family: var(--mono); font-size: 1.4rem; line-height: 1;
}
.fin-bar-sub {
  font-family: var(--mono); font-size: .62rem;
  color: var(--ink-soft); margin-top: 5px;
}

/* Toast */
#toast {
  position: fixed; bottom: 24px; left: 50%;
  transform: translateX(-50%) translateY(10px);
  background: var(--ink); color: #fff;
  border-top: 2px solid var(--gold);
  padding: 10px 24px; font-family: var(--sans);
  font-size: .72rem; font-weight: 600; letter-spacing: .04em;
  opacity: 0; transition: all .2s; z-index: 9999;
  pointer-events: none; white-space: nowrap;
}
#toast.show { opacity: 1; transform: translateX(-50%) translateY(0); }

/* Scrollbar */
::-webkit-scrollbar { width: 5px; height: 5px; }
::-webkit-scrollbar-track { background: var(--bone); }
::-webkit-scrollbar-thumb { background: var(--rule-heavy); }

/* Vendor list */
.vendor-list { border-left: 1px solid var(--rule); border-top: 1px solid var(--rule); }
.vendor-card {
  display: grid; grid-template-columns: 1fr 120px 120px 100px 80px 36px;
  border-right: 1px solid var(--rule); border-bottom: 1px solid var(--rule);
  align-items: center;
}
.vendor-card > * {
  padding: 10px 14px;
  border-right: 1px solid var(--rule);
}
.vendor-card > *:last-child { border-right: none; }
.vendor-card:hover { background: var(--bone); }

/* Project detail modal grid */
.proj-assign-row {
  display: grid; grid-template-columns: 1fr 90px 90px 36px;
  border: 1px solid var(--rule); border-top: none;
  align-items: center;
}
.proj-assign-row > * {
  padding: 7px 10px;
  border-right: 1px solid var(--rule);
}
.proj-assign-row > *:last-child { border-right: none; }
.proj-assign-hdr {
  display: grid; grid-template-columns: 1fr 90px 90px 36px;
  border: 1px solid var(--rule);
  background: var(--bone);
}
.proj-assign-hdr > * {
  padding: 6px 10px;
  border-right: 1px solid var(--rule);
  font-size: .58rem; font-weight: 700;
  text-transform: uppercase; letter-spacing: .08em; color: var(--ink-soft);
}
.proj-assign-hdr > *:last-child { border-right: none; }

/* Add row button */
.add-row-btn {
  border: 1px dashed var(--rule);
  border-top: none; width: 100%;
  background: transparent; padding: 7px;
  font-family: var(--sans); font-size: .7rem;
  color: var(--ink-soft); cursor: pointer;
  text-align: left; padding-left: 12px;
  transition: all .12s;
}
.add-row-btn:hover { background: var(--bone); color: var(--ink); }

/* Projection panel */
.proj-panel {
  border-left: 1px solid var(--rule);
  border-top: 1px solid var(--rule);
}
.pq-row {
  display: grid;
  grid-template-columns: 40px 1fr 120px 80px 80px 36px;
  border-right: 1px solid var(--rule);
  border-bottom: 1px solid var(--rule);
  align-items: center;
}
.pq-row > * {
  padding: 10px 12px;
  border-right: 1px solid var(--rule);
}
.pq-row > *:last-child { border-right: none; }

/* Implant block */
.implant-block {
  border: 1px solid var(--rule); margin-top: 4px;
}
.implant-header {
  display: flex; align-items: center; gap: 12px;
  padding: 9px 12px; background: var(--bone);
  border-bottom: 1px solid var(--rule);
}
</style>
</head>
<body>

<!-- HEADER -->
<header>
  <div class="logo">
    ALG
    <div class="logo-pipe"></div>
    <span class="logo-sub">Dashboard</span>
  </div>
  <nav>
    <button class="active" onclick="showPage('dashboard',this)">Overview</button>
    <button onclick="showPage('projects',this)">Proyectos</button>
    <button onclick="showPage('employees',this)">Equipo</button>
    <button onclick="showPage('vendors',this)">Proveedores</button>
    <button onclick="showPage('expenses',this)">Gastos</button>
  </nav>
  <div class="header-right">
    <div id="sync-status"></div>
    <div class="header-month" style="display:flex;align-items:center;gap:8px">
      <label>TC USD</label>
      <input type="number" id="tc-usd" value="17.90" step="0.05" min="1" style="width:70px" oninput="renderAll()">
    </div>
    <div class="header-month" style="display:flex;align-items:center;gap:8px">
      <label>Mes</label>
      <input type="month" id="active-month" style="width:130px" oninput="renderAll()">
    </div>
  </div>
</header>

<!-- POPOVER -->
<div class="popover" id="popover"></div>

<!-- TOAST -->
<div id="toast"></div>

<!-- ══ DASHBOARD ══ -->
<div class="page active" id="page-dashboard">
  <div class="dash-grid" id="dash-grid">
    <!-- Rendered by JS -->
  </div>
</div>

<!-- ══ PROJECTS ══ -->
<div class="page" id="page-projects">
  <div class="page-bar">
    <h1>Proyectos <small id="proj-count"></small></h1>
    <button class="btn gold" onclick="openProjectModal()">＋ Proyecto</button>
  </div>
  <div id="projects-list"></div>
  <div id="proj-empty" style="display:none;padding:60px;text-align:center;color:var(--ink-soft);font-size:.82rem">Sin proyectos. Crea el primero.</div>
</div>

<!-- ══ EMPLOYEES ══ -->
<div class="page" id="page-employees">
  <div class="page-bar">
    <h1>Equipo <small id="emp-count"></small></h1>
    <button class="btn gold" onclick="openModal('employee')">＋ Colaborador</button>
  </div>
  <div id="employees-section"></div>
</div>

<!-- ══ VENDORS ══ -->
<div class="page" id="page-vendors">
  <div class="page-bar">
    <h1>Proveedores <small id="vendor-count"></small></h1>
    <button class="btn gold" onclick="openModal('vendor')">＋ Proveedor</button>
  </div>
  <div style="display:flex;gap:8px;padding:12px 24px;background:var(--bone);border-bottom:1px solid var(--rule)">
    <button class="btn ghost" onclick="filterVendors('all',this)" style="font-size:.65rem">Todos</button>
    <button class="btn ghost" onclick="filterVendors('active',this)" style="font-size:.65rem">Activos</button>
    <button class="btn ghost" onclick="filterVendors('inactive',this)" style="font-size:.65rem">Inactivos</button>
  </div>
  <div id="vendors-list" class="vendor-list"></div>
  <div id="vendor-empty" style="display:none;padding:60px;text-align:center;color:var(--ink-soft);font-size:.82rem">Sin proveedores.</div>
  <div id="vendor-summary-card" style="display:none"></div>
</div>

<!-- ══ EXPENSES ══ -->
<div class="page" id="page-expenses">
  <div class="page-bar">
    <h1>Gastos operativos <small id="exp-count"></small></h1>
    <button class="btn gold" onclick="addExpenseRow()">＋ Gasto</button>
  </div>
  <div class="section-table-wrap">
    <table class="stbl" id="exp-table" style="min-width:700px">
      <thead>
        <tr>
          <th style="width:130px">Categoría</th>
          <th>Concepto</th>
          <th class="r" style="width:130px">Monto base</th>
          <th style="width:70px;text-align:center">IVA</th>
          <th class="r" style="width:130px">Total</th>
          <th style="width:90px;text-align:center">Fijo</th>
          <th style="width:36px"></th>
        </tr>
      </thead>
      <tbody id="exp-tbody"></tbody>
      <tfoot id="exp-tfoot"></tfoot>
    </table>
  </div>
  <div id="exp-empty" style="display:none;padding:60px;text-align:center;color:var(--ink-soft);font-size:.82rem">Sin gastos registrados.</div>
</div>


<!-- ══ MODALS ══ -->
<!-- PROJECT -->
<div class="modal-overlay" id="modal-project">
  <div class="modal" style="width:620px">
    <h3 id="modal-project-title">Nuevo proyecto</h3>
    <div class="field-row">
      <div class="field-group"><label>Nombre</label><input type="text" id="p-name" placeholder="Brand Identity ACME"></div>
      <div class="field-group"><label>Cliente</label><input type="text" id="p-client" placeholder="Nombre del cliente"></div>
    </div>
    <div class="field-row">
      <div class="field-group">
