function refreshImplantBtn() {
  const btn = document.getElementById('ee-implant-btn');
  if (!btn) return;
  if (_editIsImplant) {
    btn.textContent    = '✅ Implant';
    btn.style.background   = 'var(--green-bg)';
    btn.style.color        = 'var(--green)';
    btn.style.borderColor  = 'var(--green)';
  } else {
    btn.textContent    = 'No implant';
    btn.style.background   = 'transparent';
    btn.style.color        = 'var(--ink-soft)';
