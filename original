function toggleProjPanel() {
  _projPanelOpen = !_projPanelOpen;
  const panel = document.getElementById('proj-panel');
  panel.classList.toggle('open', _projPanelOpen);
  if (_projPanelOpen) renderProjectionPanel();
}

function setActiveScenario(s) {
  _activeScenario = s;
  ['A','B','all'].forEach(x => {
    const btn = document.getElementById(`scen-tab-${x.toLowerCase()}`);
    if (btn) btn.classList.toggle('on', x === s);
  });
  renderProjectionPanel();
}

// Get quotes active in current scenario
function getActiveQuotes() {
  if (_activeScenario === 'all') return pendingQuotes;
  if (_activeScenario === 'A')   return pendingQuotes.filter(q => q.scenA);
  if (_activeScenario === 'B')   return pendingQuotes.filter(q => q.scenB);
  return [];
}

// Projected income = base income + active quotes (weighted by probability)
function projectedIncome(weighted=false) {
  const base = totalMonthlyIncomeBase();
  const extra = getActiveQuotes().reduce((s, q) => {
    const inc = q.income || 0;
    return s + (weighted ? inc * (q.prob/100) : inc);
  }, 0);
  return (base + extra) * (1 + IVA);
}

function projectedMargin(weighted=false) {
  const payroll = totalMonthlyPayroll(true);
  const vendors = totalVendorCost();
  const exps    = totalExpenses();
  return projectedIncome(weighted) - payroll - vendors - exps;
}

// Projected hours per employee
function projectedEmpHrs(empId) {
  const current = getEmployeeAssignedHrs(empId);
  const extra   = getActiveQuotes().reduce((s, q) => {
    const a = (q.assignments||[]).find(x => x.empId === empId);
    return s + (a ? (a.hrs||0) : 0);
  }, 0);
  return current + extra;
}

function renderProjectionPanel() {
  const hasQuotes = pendingQuotes.length > 0;
  (document.getElementById('pq-empty')||{style:{}}).style.display      = hasQuotes ? 'none' : 'block';
  (document.getElementById('pq-scen-bar')||{style:{}}).style.display   = hasQuotes ? 'flex' : 'none';
  (document.getElementById('pq-delta')||{style:{}}).style.display      = hasQuotes ? 'grid' : 'none';
  (document.getElementById('pq-list')||{style:{}}).style.display       = hasQuotes ? 'block' : 'none';
  (document.getElementById('pq-capacity')||{style:{}}).style.display   = hasQuotes && employees.length ? 'block' : 'none';

  const badge = document.getElementById('pq-count-badge');
  badge.textContent = hasQuotes ? `(${pendingQuotes.length} pendiente${pendingQuotes.length>1?'s':''})` : '';

  if (!hasQuotes) return;

  renderPqDelta();
  renderPqList();
  renderPqCapacity();
}

function renderPqDelta() {
  const curInc  = totalMonthlyIncomeBase() * (1 + IVA);
  const curMarg = curInc - totalMonthlyPayroll(true) - totalVendorCost() - totalExpenses();
  const proInc  = projectedIncome(false);
  const proIncW = projectedIncome(true);
  const proMarg = projectedMargin(false);
  const proMargW= projectedMargin(true);
  const activeQ = getActiveQuotes();
  const extraHrs= activeQ.reduce((s,q)=>(q.assignments||[]).reduce((ss,a)=>ss+(a.hrs||0),0)+s,0);

  const fmtDelta = (v, cur) => {
    const d = v - cur;
    if (Math.abs(d) < 1) return '<span style="color:var(--ink-soft)">Sin cambio</span>';
    const sign = d > 0 ? '+' : '';
    const col  = d > 0 ? 'var(--green)' : 'var(--accent-2)';
    return `<span style="color:${col};font-weight:700">${sign}${fmt(d)}</span>`;
  };

  const _pq_deltaEl = document.getElementById('pq-delta'); if(_pq_deltaEl) _pq_deltaEl.innerHTML = `
    <div class="delta-card">
      <div class="delta-label">Ingresos proyectados</div>
      <div class="delta-current">${fmt(curInc)} actual</div>
      <div class="delta-arrow" style="color:#7c3aed">↓</div>
      <div class="delta-projected" style="color:#7c3aed">${fmt(proInc)}</div>
      <div class="delta-diff">${fmtDelta(proInc, curInc)}</div>
    </div>
    <div class="delta-card">
      <div class="delta-label">Ingreso ponderado (prob.)</div>
      <div class="delta-current">${fmt(curInc)} actual</div>
      <div class="delta-arrow" style="color:#0891b2">↓</div>
      <div class="delta-projected" style="color:#0891b2">${fmt(proIncW)}</div>
      <div class="delta-diff" style="font-size:.68rem;color:var(--ink-soft)">Ajustado por probabilidad</div>
    </div>
    <div class="delta-card">
      <div class="delta-label">Margen neto proyectado</div>
      <div class="delta-current">${fmt(curMarg)} actual</div>
      <div class="delta-arrow" style="color:#7c3aed">↓</div>
      <div class="delta-projected" style="color:${proMarg>=0?'var(--green)':'var(--accent-2)'}">${fmt(proMarg)}</div>
      <div class="delta-diff">${fmtDelta(proMarg, curMarg)}</div>
    </div>
    <div class="delta-card">
      <div class="delta-label">Cotizaciones activas</div>
      <div class="delta-current" style="font-size:.72rem">${activeQ.length} de ${pendingQuotes.length} seleccionadas</div>
      <div class="delta-arrow" style="color:#7c3aed">↓</div>
      <div class="delta-projected" style="color:#7c3aed">${fmt(activeQ.reduce((s,q)=>s+(q.income||0),0))}</div>
      <div class="delta-diff" style="font-size:.68rem;color:var(--ink-soft)">${extraHrs} hrs adicionales</div>
    </div>`;
}

