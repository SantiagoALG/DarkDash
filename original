let _editIsImplant = false;

function toggleImplant() {
  _editIsImplant = !_editIsImplant;
  if (_editIsImplant) {
    const curOh = parseFloat(document.getElementById('ee-overhead').value);
    if (curOh >= OVERHEAD_RATE) document.getElementById('ee-overhead').value = '0.2';
